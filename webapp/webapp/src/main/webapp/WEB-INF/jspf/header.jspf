<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.volunteerstar.pojo.User" %>
<%
  String currentPage = (String) request.getAttribute("currentPage");
  if (currentPage == null) {
    currentPage = "";
  }
  User headerUser = (User) session.getAttribute("loginUser");
  String headerRole = headerUser == null ? "" : headerUser.getRole();
%>
<header class="site-nav">
  <div class="site-nav__inner">
    <a class="brand" href="${pageContext.request.contextPath}/index.jsp">
      <span class="brand__mark"></span>
      <span class="brand__name">志愿星河</span>
    </a>
    <nav class="site-nav__links">
      <a class="site-nav__link <%= "home".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/index.jsp">首页</a>
      <a class="site-nav__link <%= "activities".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/activities.jsp">活动中心</a>
      <a class="site-nav__link <%= "heatmap".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/heatmap.jsp">热力地图</a>
      <a class="site-nav__link <%= "pointsmall".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/points-mall.jsp">积分商城</a>
      <a class="site-nav__link <%= "dashboard".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/dashboard.jsp">个人中心</a>
      <a class="site-nav__link <%= "discover".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/discover.jsp">发现</a>
      <a class="site-nav__link <%= "planet".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/planet.jsp">志愿星球</a>
      <% if ("1".equals(headerRole)) { %>
        <a class="site-nav__link <%= "admin".equals(currentPage) ? "is-active" : "" %>" href="${pageContext.request.contextPath}/admin.jsp">管理后台</a>
      <% } %>
    </nav>
    <div class="site-nav__actions">
      <% if ("1".equals(headerRole)) { %>
        <a class="site-nav__cta" href="${pageContext.request.contextPath}/admin.jsp">管理后台</a>
      <% } %>
      <a class="site-nav__cta site-nav__cta--ghost" href="${pageContext.request.contextPath}/auth?action=logout">退出登录</a>
    </div>
  </div>
</header>
